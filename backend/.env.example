# LexClock backend environment — copy to .env.local for `vercel dev`,
# and set the same keys in the Vercel project dashboard for production.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key — server-only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Anthropic (server-side estimates so the key stays off the device) ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001

# --- Cron protection ---
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET` when this
# is set, so /api/cron/nightly rejects any other caller.
CRON_SECRET=generate-a-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins. Leave empty in local dev to
# reflect the caller; set explicitly in production.
ALLOWED_ORIGINS=https://peteyfranchise.github.io
