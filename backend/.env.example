# LexClock backend environment — copy to .env.local for `vercel dev`,
# and set the same keys in the Vercel project dashboard for production.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key — server-only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Anthropic (server-side estimates so the key stays off the device) ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001

# --- Cron protection ---
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET` when this
# is set, so /api/cron/nightly rejects any other caller.
CRON_SECRET=generate-a-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins. Leave empty in local dev to
# reflect the caller; set explicitly in production.
ALLOWED_ORIGINS=https://getlexclock.com

# --- App redirect ---
# Where OAuth callbacks return the browser after connecting a source. Defaults to
# the first ALLOWED_ORIGINS entry + /app/ if unset.
APP_BASE_URL=https://getlexclock.com/app/

# --- Google OAuth (Gmail, gmail.readonly restricted scope) ---
# From Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Redirect URI must EXACTLY match the one registered in the Google Cloud console.
GOOGLE_OAUTH_REDIRECT_URI=https://lexclock-backend.vercel.app/api/oauth/google/callback
